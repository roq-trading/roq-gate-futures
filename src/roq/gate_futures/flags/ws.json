{
  "name": "WS",
  "type": "flags",
  "prefix": "ws_",
  "values": [
    {
      "name": "uri",
      "type": "roq::io::web::URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://api.gateio.ws/ws/v4/btc",
      "description": "WS end-point (URI)"
    },
    {
      "name": "ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "5s",
      "description": "ping frequency"
    },
    {
      "name": "request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "15s",
      "description": "request: timeout"
    },
    {
      "name": "max_subscriptions_per_stream",
      "type": "uint32_t",
      "required": true,
      "default": 100,
      "description": "max symbols per connection (count)"
    },
    {
      "name": "mbp_request_delay",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "500ms",
      "description": "request delay"
    },
    {
      "name": "mbp_request_max_retries",
      "type": "uint32_t",
      "default": 3,
      "description": "request max retries"
    }
  ]
}
